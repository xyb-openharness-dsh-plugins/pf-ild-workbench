{
  "name": "@xyb-community/pf-ild-workbench",
  "version": "0.1.0",
  "description": "本机优先的进行性纤维化性间质性肺疾病（PF-ILD）肺功能趋势、氧状态、急性加重事件与复诊准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node scripts/check-workbench-package.mjs . && node scripts/check-host-contract.mjs",
    "check:host": "node scripts/check-host-contract.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.mjs",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run test && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:artifact": "node scripts/serve-artifact.mjs",
    "probe:tabs": "python3 scripts/verify-tabs-on-artifact.py",
    "probe:page-view": "node scripts/probe-page-view.mjs",
    "check:paths": "node scripts/check-interaction-paths.mjs",
    "build:demo": "node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs",
    "check:all": "npm run check && npm run check:paths && npm run check:wording && npm run check:schema",
    "check:wording": "node scripts/check-wording.mjs",
    "probe:resp": "node scripts/probe-responsive.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "fetch:trials": "node --disable-warning=ExperimentalWarning scripts/fetch-pf-ild-trials.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/pf-ild-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
